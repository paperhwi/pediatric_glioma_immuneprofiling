# Only track scripts/ and output/ from this working directory.
*
!.gitignore
!.gitattributes
!README.md
!scripts/
!scripts/**
!output/
!output/**
!cancers_submission_2026/
!cancers_submission_2026/**

# Never add raw/restricted study inputs to the public Cancers bundle.
cancers_submission_2026/**/*.rds
cancers_submission_2026/**/*.RData
cancers_submission_2026/**/*.h5
cancers_submission_2026/**/*.h5ad
cancers_submission_2026/**/*tpm_for_cibersortx*
cancers_submission_2026/**/*cohort_main_final*
cancers_submission_2026/**/*histologies*

# junk inside tracked dirs
**/__pycache__/
**/*.pyc
**/.ipynb_checkpoints/

# 172MB raw TPM matrix exceeds GitHub's 100MB limit; the .gz version is tracked instead
output/tpm_for_cibersortx.tsv

# Individual outcome/covariate inputs and event-time residuals are not public outputs.
**/restricted_os_fix.tsv
**/observations_n343.tsv
**/cox_design_axis_library_adjusted_n245.tsv
**/axis_scaled_Schoenfeld_library_adjusted.tsv
**/.n343_private_outputs/
**/.cache/
**/.qa/
